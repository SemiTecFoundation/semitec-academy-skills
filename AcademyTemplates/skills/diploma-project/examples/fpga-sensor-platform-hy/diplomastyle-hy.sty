%% diplomastyle-hy.sty — Armenian (XeLaTeX) variant of the diploma template style.
%% Compile with XeLaTeX. Uses FreeSerif, which covers both Armenian and Latin,
%% so technical terms (FPGA, AXI, RTL, Zynq) stay in Latin inside Armenian text.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{diplomastyle-hy}[2026/09/10 v1.0 Diploma template style (Armenian/XeLaTeX)]

%% ---------------------------------------------------------------- packages
\RequirePackage{fontspec}
\RequirePackage[a4paper,margin=2.5cm,bindingoffset=0.6cm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{caption}
\RequirePackage{xcolor}
\RequirePackage{amsmath,amssymb}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\RequirePackage{xparse}
\RequirePackage{etoolbox}   % robust \ifdefempty for optional title-page fields
\RequirePackage{enumitem}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,calc,fit,backgrounds}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage[acronym,toc,nonumberlist]{glossaries}
\tcbuselibrary{skins,breakable}

%% ---------------------------------------------------------------- fonts (Armenian + Latin)
\setmainfont{FreeSerif}
\setsansfont{FreeSans}
\setmonofont{FreeMono}[Scale=0.92]

%% ---------------------------------------------------------------- Armenian fixed strings
\renewcommand{\contentsname}{Բովանդակություն}
\renewcommand{\listfigurename}{Նկարների ցանկ}
\renewcommand{\listtablename}{Աղյուսակների ցանկ}
\renewcommand{\figurename}{Նկար}
\renewcommand{\tablename}{Աղյուսակ}
\renewcommand{\chaptername}{Բաժին}
\renewcommand{\appendixname}{Հավելված}
\renewcommand{\bibname}{Գրականություն}

%% ---------------------------------------------------------------- look & feel
\onehalfspacing
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}
\setlength{\headheight}{15pt}
\definecolor{dipaccent}{RGB}{40,70,110}
\definecolor{dipgray}{RGB}{90,90,90}
\captionsetup{font=small,labelfont=bf}

%% ---------------------------------------------------------------- metadata store
\newcommand{\dip@title}{Վերնագիր}
\newcommand{\dip@subtitle}{}
\newcommand{\dip@worktype}{Ավարտական աշխատանքի առաջադրանք}
\newcommand{\dip@studentone}{Ուսանող 1}
\newcommand{\dip@deptone}{Ամբիոն 1}
\newcommand{\dip@studenttwo}{}   % optional second student (cross-disciplinary)
\newcommand{\dip@depttwo}{}
\newcommand{\dip@supervisorone}{Ղեկավար}
\newcommand{\dip@supervisortwo}{}
\newcommand{\dip@institution}{Համալսարան}
\newcommand{\dip@faculty}{Ֆակուլտետ}
\newcommand{\dip@city}{Երևան}
\newcommand{\dip@year}{\the\year}

\newcommand{\setprojecttitle}[1]{\renewcommand{\dip@title}{#1}}
\newcommand{\setprojectsubtitle}[1]{\renewcommand{\dip@subtitle}{#1}}
\newcommand{\setworktype}[1]{\renewcommand{\dip@worktype}{#1}}
\newcommand{\setstudentone}[1]{\renewcommand{\dip@studentone}{#1}}
\newcommand{\setdeptone}[1]{\renewcommand{\dip@deptone}{#1}}
\newcommand{\setstudenttwo}[1]{\renewcommand{\dip@studenttwo}{#1}}
\newcommand{\setdepttwo}[1]{\renewcommand{\dip@depttwo}{#1}}
\newcommand{\setsupervisorone}[1]{\renewcommand{\dip@supervisorone}{#1}}
\newcommand{\setsupervisortwo}[1]{\renewcommand{\dip@supervisortwo}{#1}}
\newcommand{\setinstitution}[1]{\renewcommand{\dip@institution}{#1}}
\newcommand{\setfaculty}[1]{\renewcommand{\dip@faculty}{#1}}
\newcommand{\setcity}[1]{\renewcommand{\dip@city}{#1}}
\newcommand{\setyear}[1]{\renewcommand{\dip@year}{#1}}

%% ---------------------------------------------------------------- title page (two students)
\newcommand{\maketitlepage}{%
  \begin{titlepage}
    \centering
    {\large\scshape \dip@institution\par}
    {\normalsize \dip@faculty\par}
    \vspace{1.4cm}
    {\normalsize \dip@worktype\par}
    \vspace{1.0cm}
    \rule{\linewidth}{0.4pt}\par\vspace{0.5cm}
    {\LARGE\bfseries \dip@title\par}
    \ifdefempty{\dip@subtitle}{}{\vspace{0.4cm}{\large \dip@subtitle\par}}
    \vspace{0.5cm}\rule{\linewidth}{0.4pt}\par
    \vfill
    \begin{flushleft}\large
      \ifdefempty{\dip@studenttwo}{%
        % --- simple diploma: one student ---
        \textbf{Ուսանող.}~\dip@studentone\\[-0.2em]
        {\normalsize\color{dipgray}\dip@deptone}\par\medskip
        \textbf{Ղեկավար.}~\dip@supervisorone\par
      }{%
        % --- cross-disciplinary: two students ---
        \textbf{Ուսանող 1.}~\dip@studentone\\[-0.2em]
        {\normalsize\color{dipgray}\dip@deptone}\par\smallskip
        \textbf{Ուսանող 2.}~\dip@studenttwo\\[-0.2em]
        {\normalsize\color{dipgray}\dip@depttwo}\par\medskip
        \textbf{Ղեկավար 1.}~\dip@supervisorone\par\smallskip
        \ifdefempty{\dip@supervisortwo}{}{\textbf{Ղեկավար 2.}~\dip@supervisortwo\par}%
      }%
    \end{flushleft}
    \vfill
    {\large \dip@city,~\dip@year\par}
  \end{titlepage}
}

%% ---------------------------------------------------------------- headers/footers
\newcommand{\dipheaderstyle}{%
  \pagestyle{fancy}\fancyhf{}%
  \fancyhead[L]{\small\nouppercase{\leftmark}}%
  \fancyhead[R]{\small Առաջադրանք}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}\renewcommand{\footrulewidth}{0pt}%
}
\newcommand{\frontmatterpages}{%
  \pagenumbering{roman}\tableofcontents\clearpage}
\newcommand{\mainmatterstart}{%
  \clearpage\pagenumbering{arabic}\dipheaderstyle}

%% ---------------------------------------------------------------- image / diagram helpers
\NewDocumentCommand{\addimage}{o m m m}{%
  \begin{figure}[htbp]\centering
    \includegraphics[width=#3\textwidth]{#2}\caption{#4}\IfValueT{#1}{\label{#1}}%
  \end{figure}}
\NewDocumentCommand{\adddiagram}{o m m m}{%
  \begin{figure}[htbp]\centering
    \resizebox{#3\textwidth}{!}{\input{diagrams/#2}}\caption{#4}\IfValueT{#1}{\label{#1}}%
  \end{figure}}

%% ---------------------------------------------------------------- callout boxes
\newtcolorbox{dipcallout}[1]{colback=dipaccent!5,colframe=dipaccent!70,
  fonttitle=\bfseries,coltitle=white,title=#1,breakable,boxrule=0.6pt,arc=2pt,left=6pt,right=6pt}
\newcommand{\problemstatement}[1]{\begin{dipcallout}{Խնդրի ձևակերպում}#1\end{dipcallout}}
\newcommand{\summarybox}[1]{\begin{dipcallout}{Ամփոփում}#1\end{dipcallout}}
\newcommand{\notebox}[1]{\begin{dipcallout}{Նշում}#1\end{dipcallout}}
\newcommand{\keypoint}[1]{\begin{dipcallout}{Կարևոր}#1\end{dipcallout}}

%% ---------------------------------------------------------------- abbreviations & glossary
%% Prints "Հապավումների ցանկ" (abbreviations) and "Բառարան" (glossary).
%% \glsaddall lists every defined entry, even if unused in the text.
\newcommand{\printglossarysection}{%
  \clearpage
  \glsaddall
  \printglossary[type=\acronymtype,title={Հապավումների ցանկ}]%
  \printglossary[title={Բառարան}]%
}

\endinput

%% diplomastyle.sty — style & custom commands for the diploma/thesis template.
%% All packages, page setup, and the helper functions live here so that
%% main.tex stays short and the author mostly edits metadata + sections.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{diplomastyle}[2026/09/10 v1.0 Diploma/Thesis/Research project template]

%% ---------------------------------------------------------------- packages
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{mathptmx}      % Times (Type1) text+math — avoids bitmap-font generation
\RequirePackage[a4paper,margin=2.5cm,bindingoffset=0.6cm]{geometry}
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage{xcolor}
\RequirePackage{amsmath,amssymb}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\RequirePackage{xparse}
\RequirePackage{etoolbox}   % robust \ifdefempty for optional title-page fields
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,calc}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage[acronym,toc,nonumberlist]{glossaries}
\RequirePackage[hidelinks]{hyperref}
\tcbuselibrary{skins,breakable}

%% ---------------------------------------------------------------- look & feel
\onehalfspacing
\setlength{\parskip}{0.5em}
\setlength{\parindent}{0pt}
\setlength{\headheight}{15pt}
\definecolor{dipaccent}{RGB}{40,70,110}
\definecolor{dipgray}{RGB}{90,90,90}
\captionsetup{font=small,labelfont=bf}

%% ---------------------------------------------------------------- metadata store
\newcommand{\dip@title}{Project Title}
\newcommand{\dip@subtitle}{}
\newcommand{\dip@author}{Author Name}
\newcommand{\dip@supervisor}{Supervisor}
\newcommand{\dip@cosupervisor}{}
%% Optional second student — set these only for a cross-disciplinary project.
\newcommand{\dip@authortwo}{}
\newcommand{\dip@authortwodept}{}
\newcommand{\dip@supervisortwo}{}
\newcommand{\dip@institution}{University}
\newcommand{\dip@department}{Department}
\newcommand{\dip@program}{Program}
\newcommand{\dip@degree}{Degree}
\newcommand{\dip@worktype}{Diploma Project}
\newcommand{\dip@field}{Field}
\newcommand{\dip@city}{City}
\newcommand{\dip@year}{\the\year}

%% ---- setters the author calls in metadata.tex ----
\newcommand{\setprojecttitle}[1]{\renewcommand{\dip@title}{#1}}
\newcommand{\setprojectsubtitle}[1]{\renewcommand{\dip@subtitle}{#1}}
\newcommand{\setauthor}[1]{\renewcommand{\dip@author}{#1}}
\newcommand{\setsupervisor}[1]{\renewcommand{\dip@supervisor}{#1}}
\newcommand{\setcosupervisor}[1]{\renewcommand{\dip@cosupervisor}{#1}}
%% Cross-disciplinary: second student + their department + their supervisor.
\newcommand{\setsecondauthor}[1]{\renewcommand{\dip@authortwo}{#1}}
\newcommand{\setsecondauthordept}[1]{\renewcommand{\dip@authortwodept}{#1}}
\newcommand{\setsecondsupervisor}[1]{\renewcommand{\dip@supervisortwo}{#1}}
\newcommand{\setinstitution}[1]{\renewcommand{\dip@institution}{#1}}
\newcommand{\setdepartment}[1]{\renewcommand{\dip@department}{#1}}
\newcommand{\setprogram}[1]{\renewcommand{\dip@program}{#1}}
\newcommand{\setdegree}[1]{\renewcommand{\dip@degree}{#1}}
\newcommand{\setworktype}[1]{\renewcommand{\dip@worktype}{#1}}
\newcommand{\setfield}[1]{\renewcommand{\dip@field}{#1}}
\newcommand{\setcity}[1]{\renewcommand{\dip@city}{#1}}
\newcommand{\setyear}[1]{\renewcommand{\dip@year}{#1}}

%% ---------------------------------------------------------------- title page
\newcommand{\maketitlepage}{%
  \begin{titlepage}
    \centering
    {\large\scshape \dip@institution\par}
    {\normalsize \dip@department\par}
    \vspace{1.5cm}
    {\small\uppercase\expandafter{\dip@worktype}\par}
    \vspace{1.2cm}
    \rule{\linewidth}{0.4pt}\par\vspace{0.5cm}
    {\huge\bfseries \dip@title\par}
    \ifdefempty{\dip@subtitle}{}{\vspace{0.4cm}{\Large \dip@subtitle\par}}
    \vspace{0.5cm}\rule{\linewidth}{0.4pt}\par
    \vfill
    \begin{flushleft}\large
      \textbf{Author:}~\dip@author\par\smallskip
      \textbf{Supervisor:}~\dip@supervisor\par
      \ifdefempty{\dip@cosupervisor}{}{\smallskip\textbf{Co-supervisor:}~\dip@cosupervisor\par}%
      \ifdefempty{\dip@authortwo}{}{%
        \medskip\textbf{Second author:}~\dip@authortwo\par
        \ifdefempty{\dip@authortwodept}{}{{\normalsize\color{dipgray}\dip@authortwodept\par}}%
        \ifdefempty{\dip@supervisortwo}{}{\smallskip\textbf{Second supervisor:}~\dip@supervisortwo\par}%
      }%
      \smallskip\textbf{Program:}~\dip@program\par
      \smallskip\textbf{Degree:}~\dip@degree\par
      \smallskip\textbf{Field:}~\dip@field\par
    \end{flushleft}
    \vfill
    {\large \dip@city,~\dip@year\par}
  \end{titlepage}
}

%% ---------------------------------------------------------------- back page
\newcommand{\makebackpage}{%
  \clearpage
  \thispagestyle{empty}
  \null\vfill
  \begin{center}\small\color{dipgray}
    \dip@institution\\ \dip@department\\ \dip@city,~\dip@year
  \end{center}
}

%% ---------------------------------------------------------------- headers/footers
\newcommand{\dipheaderstyle}{%
  \pagestyle{fancy}%
  \fancyhf{}%
  \fancyhead[L]{\small\nouppercase{\leftmark}}%
  \fancyhead[R]{\small\dip@author}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

%% ---------------------------------------------------------------- front / main matter
\newcommand{\frontmatterpages}[1]{%
  \pagenumbering{roman}%
  \tableofcontents
  \clearpage
  \listoffigures
  \listoftables
  \clearpage
  #1% e.g. the abstract
  \clearpage
}
\newcommand{\mainmatterstart}{%
  \clearpage
  \pagenumbering{arabic}%
  \dipheaderstyle
}

%% ---------------------------------------------------------------- IMAGE function
%% \addimage[label]{file}{width 0-1}{caption}
%% Centered figure; width is a fraction of the text width.
\NewDocumentCommand{\addimage}{o m m m}{%
  \begin{figure}[htbp]
    \centering
    \includegraphics[width=#3\textwidth]{#2}
    \caption{#4}%
    \IfValueT{#1}{\label{#1}}%
  \end{figure}%
}

%% ---------------------------------------------------------------- DIAGRAM function
%% \adddiagram[label]{name}{width 0-1}{caption}
%% Inputs diagrams/<name>.tex (a TikZ picture) and scales it to the given width.
\NewDocumentCommand{\adddiagram}{o m m m}{%
  \begin{figure}[htbp]
    \centering
    \resizebox{#3\textwidth}{!}{\input{diagrams/#2}}%
    \caption{#4}%
    \IfValueT{#1}{\label{#1}}%
  \end{figure}%
}

%% ---------------------------------------------------------------- callout boxes
\newtcolorbox{dipcallout}[1]{%
  colback=dipaccent!5, colframe=dipaccent!70, fonttitle=\bfseries,
  coltitle=white, title=#1, breakable, boxrule=0.6pt, arc=2pt, left=6pt, right=6pt}

\newcommand{\problemstatement}[1]{\begin{dipcallout}{Problem Statement}#1\end{dipcallout}}
\newcommand{\summarybox}[1]{\begin{dipcallout}{Summary}#1\end{dipcallout}}
\newcommand{\keypoint}[1]{\begin{dipcallout}{Key Point}#1\end{dipcallout}}
\newcommand{\notebox}[1]{\begin{dipcallout}{Note}#1\end{dipcallout}}

%% ---------------------------------------------------------------- back matter
\newcommand{\printbibsection}{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{References}%
  \bibliographystyle{unsrtnat}%
  \bibliography{references}%
}
\newcommand{\printglossarysection}{%
  \clearpage
  \glsaddall % list every defined abbreviation/term, even if unused in the text
  \printglossary[type=\acronymtype,title={List of Abbreviations}]%
  \printglossary[title={Glossary}]%
}
\newcommand{\appendixsection}[1]{%
  \clearpage
  \appendix
  #1%
}

\endinput
